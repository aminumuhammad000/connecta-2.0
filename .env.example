# Connecta 2.0 Environment Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Resend
RESEND_API_KEY=re_...
RESEND_SENDER_EMAIL=security@myconnecta.ng

# AI Services
OPENAI_API_KEY=sk-proj-...
ELEVENLABS_API_KEY=sk_...

# Google Authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Flutterwave Payment & Escrow
FLUTTERWAVE_CLIENT_ID=your-flutterwave-client-id
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key
FLUTTERWAVE_ENCRYPTION_KEY=your-flutterwave-encryption-key
FLUTTERWAVE_SECRET_HASH=your-flutterwave-secret-hash

# App & Regional Settings
NEXT_PUBLIC_APP_NAME="Connecta"
NEXT_PUBLIC_APP_URL="https://connecta.ng"
NEXT_PUBLIC_DEFAULT_CITY="Kano"
NEXT_PUBLIC_DEFAULT_CURRENCY="NGN"

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_NAME="Connecta Platform"
FROM_EMAIL=your-email@gmail.com

# Database & Server Settings
MONGO_URI=mongodb://127.0.0.1:27017/connecta
JWT_SECRET=your-jwt-secret
PORT=5001
