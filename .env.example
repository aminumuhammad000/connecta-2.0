# Connecta 2.0 Environment Configuration
# Copy this file to .env.local and populate with your project credentials.

# 1. Supabase (Database, Auth, Realtime, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# 3. Cloudinary (Media Uploads & Job Evidence)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# 4. Resend (Transactional Marketplace Emails)
RESEND_API_KEY=re_...
RESEND_SENDER_EMAIL=notifications@connecta.ng

# 5. App & Regional Settings
NEXT_PUBLIC_APP_NAME="Connecta 2.0"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CITY="Kano"
NEXT_PUBLIC_DEFAULT_CURRENCY="NGN"
